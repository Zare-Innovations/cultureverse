# Ticketmaster event page. Every "Get tickets" / "Tickets" button opens this in a new tab.
NEXT_PUBLIC_TICKETMASTER_URL=https://www.ticketmaster.com/[CULTUREBOWL EVENT URL]

# Endpoint that receives the four forms as JSON POST bodies. Each body carries a "form" field:
# "tap-in", "exchnge", "biggive" or "iconhonors".
NEXT_PUBLIC_FORM_ENDPOINT=

# Squarespace commerce shop.
NEXT_PUBLIC_SHOP_URL=https://www.allthingsculturebowl.com/shop

# "true" switches the Home hero to the headliner-announced variant (02-Home-Announced).
NEXT_PUBLIC_HEADLINER_ANNOUNCED=false

# "true" once CultureExpo tickets go on sale: the Expo page swaps "Notify me" for "Get weekend tickets" and the
# Expo is labelled "Ticketed" instead of "Coming soon" wherever the events are listed.
NEXT_PUBLIC_EXPO_TICKETS_ON_SALE=false

# GA4 measurement ID (G-XXXXXXXXXX). Leave empty to ship no analytics at all.
NEXT_PUBLIC_GA_ID=
