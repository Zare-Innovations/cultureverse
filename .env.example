# Ticketmaster event page. Every "Get tickets" / "Tickets" button opens this in a new tab.
NEXT_PUBLIC_TICKETMASTER_URL=https://www.ticketmaster.com/[CULTUREBOWL EVENT URL]

# Endpoint that receives the four forms as JSON POST bodies. Each body carries a "form" field:
# "tap-in", "exchnge", "biggive" or "iconhonors".
NEXT_PUBLIC_FORM_ENDPOINT=

# Shopify storefront behind /shop. Both are safe to expose: Storefront API tokens are public by
# design, and the browser needs the token to turn a bag into a checkout. Leave empty and /shop
# renders its "not open yet" state. After setting the domain run `npm run vercel-config` and commit
# vercel.json, or the Content-Security-Policy will block the API and the product images.
NEXT_PUBLIC_SHOPIFY_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# "true" renders a placeholder catalog on /shop so the page can be reviewed before a store exists.
# Never set this in production: the products are obvious stand-ins, not real stock.
NEXT_PUBLIC_SHOP_DEMO=false

# Points every Shop link at an external store instead of /shop. Set it to
# https://www.allthingsculturebowl.com/shop to hand the shop back to Squarespace.
NEXT_PUBLIC_SHOP_URL=

# "true" switches the Home hero to the headliner-announced variant (02-Home-Announced).
NEXT_PUBLIC_HEADLINER_ANNOUNCED=false

# "true" once CultureExpo tickets go on sale: the Expo page swaps "Notify me" for "Get weekend tickets" and the
# Expo is labelled "Ticketed" instead of "Coming soon" wherever the events are listed.
NEXT_PUBLIC_EXPO_TICKETS_ON_SALE=false

# GA4 measurement ID (G-XXXXXXXXXX). Leave empty to ship no analytics at all.
NEXT_PUBLIC_GA_ID=
